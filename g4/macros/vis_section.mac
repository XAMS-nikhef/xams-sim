# Offscreen picture of the geometry: side view, cut open along the x-z plane (xamsopt -v ... vis_section.mac)
/run/initialize
/vis/open TSG_OFFSCREEN 1600x1400
/vis/tsg/offscreen/set/file xams_section.png
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility Liquid 0 false
/vis/geometry/set/visibility Gas 0 false
/vis/geometry/set/colour PTFE 0 0.95 0.95 0.95 1
/vis/geometry/set/colour MeshRing 0 0.45 0.45 0.5 1
/vis/geometry/set/colour MeshBar 0 0.2 0.2 0.25 1
/vis/geometry/set/colour TopPMTWindow 0 0.6 0.8 1.0 0.6
/vis/geometry/set/colour BottomPMTWindow 0 0.6 0.8 1.0 0.6
/vis/geometry/set/colour TopPMTSector 0 0.9 0.6 0.1 1
/vis/geometry/set/colour BottomPMTCathode 0 0.9 0.6 0.1 1
/vis/geometry/set/colour SiPM 0 0.1 0.7 0.2 1
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/viewpointThetaPhi 90 90 deg
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/cutawayMode intersection
/vis/viewer/addCutawayPlane 0 0 0 m 0 1 0
/vis/viewer/set/background white
/vis/viewer/zoomTo 1.6
/vis/viewer/set/autoRefresh true
/vis/viewer/rebuild
