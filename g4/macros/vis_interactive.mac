# Interactive viewer (xamsg4 -c config.json, no macro): Qt window with the geometry.
# Only the xenon is see-through: in this viewer, see-through volumes inside the see-through xenon are not drawn,
# so everything else is opaque. The view starts cut open (cutaway, end of this file); in the command box:
#   /vis/viewer/clearCutawayPlanes                       whole setup, closed
#   /vis/viewer/addCutawayPlane 0 0 0 m 0 1 0            cut along another plane (point x y z unit, normal nx ny nz;
#                                                        intersection mode: only what is on the kept side of all planes)
#   /vis/viewer/set/cutawayMode union                    keep what is on the kept side of any plane (a plane keeps
#                                                        the side its normal points to; quarter cut out: planes
#                                                        0 0 0 m -1 0 0 and 0 0 0 m 0 -1 0)
#   /vis/geometry/set/visibility Vessel 0 false          hide the steel vessel (also Bucket)
#   /vis/viewer/set/sectionPlane on 0 0 0 m 0 1 0        thin slice instead (off: /vis/viewer/set/sectionPlane off)
/vis/open TSG
/vis/drawVolume
/vis/viewer/set/background white
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/colour Liquid 0 0.15 0.35 0.85 0.3
/vis/geometry/set/colour Gas 0 0.55 0.75 1.0 0.15
/vis/geometry/set/colour PTFE 0 0.93 0.86 0.66 1
/vis/geometry/set/colour PTFE_gas 0 0.93 0.86 0.66 1
/vis/geometry/set/colour MeshRing 0 0.45 0.45 0.55 1
/vis/geometry/set/colour Bucket 0 0.85 0.72 0.42 1
/vis/geometry/set/colour Vessel 0 0.55 0.58 0.62 1
# mesh foils: steel pieces (bars + solid unetched cells) in a thin xenon layer; hide the layer, show the steel
/vis/geometry/set/visibility top_screenLayer 0 false
/vis/geometry/set/visibility anodeLayer 0 false
/vis/geometry/set/visibility gateLayer 0 false
/vis/geometry/set/visibility cathodeLayer 0 false
/vis/geometry/set/visibility bottom_screenLayer 0 false
/vis/geometry/set/colour MeshFoil 0 0.25 0.25 0.30 1
/vis/geometry/set/colour CopperRing 0 0.78 0.45 0.23 1
/vis/geometry/set/colour TopPMTWindow 0 0.70 0.88 1.00 1
/vis/geometry/set/colour BottomPMTWindow 0 0.70 0.88 1.00 1
/vis/geometry/set/colour TopPMTSector 0 0.95 0.60 0.10 1
/vis/geometry/set/colour BottomPMTCathode 0 0.95 0.60 0.10 1
/vis/geometry/set/colour TopPMTFrame 0 0.30 0.30 0.30 1
/vis/geometry/set/colour BottomPMTFrame 0 0.30 0.30 0.30 1
/vis/geometry/set/colour TopPMTBody 0 0.20 0.20 0.20 1
/vis/geometry/set/colour BottomPMTBody 0 0.20 0.20 0.20 1
/vis/geometry/set/colour SiPM 0 0.10 0.70 0.20 1
/vis/viewer/set/style surface
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 70 20 deg
/vis/scene/add/axes 0 0 0 20 mm
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate 200
# default source for /run/beamOn: S2 light in the gas gap
/xamsg4/source/shape s2
/xamsg4/source/rmax 30 mm
# cut open: keep the half on the side the normal points to (x < 0), i.e. remove the half towards the default
# viewpoint (70/20 deg) -> look into the TPC, bucket and vessel
/vis/viewer/set/cutawayMode intersection
/vis/viewer/addCutawayPlane 0 0 0 m -1 0 0
