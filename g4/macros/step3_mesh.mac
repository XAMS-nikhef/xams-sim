# Step 3 check: collimated beam (random points in a disc of 25 mm) through one mesh at z = 0 in liquid xenon
# (geometry_mode test_mesh, bars black). Direction set by checks/check_step3.py through {px} {py} {pz} {dx} {dy} {dz}.
/run/verbose 0
/run/initialize
/xamsg4/source/shape beam_disc
/xamsg4/source/rmax 25 mm
/xamsg4/source/position {px} {py} {pz} mm
/xamsg4/source/direction {dx} {dy} {dz}
/run/beamOn 200000
