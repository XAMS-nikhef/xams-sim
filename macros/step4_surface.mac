# Step 4 check: beam in liquid xenon onto a reflecting slab (top face at z = 0, geometry_mode test_surface).
# Direction set by tools/check_step4.py through {px} {pz} {dx} {dz}; the beam hits the origin.
/run/verbose 0
/run/initialize
/xamsopt/source/shape beam
/xamsopt/source/position {px} 0 {pz} mm
/xamsopt/source/direction {dx} 0 {dz}
/run/beamOn {n}
