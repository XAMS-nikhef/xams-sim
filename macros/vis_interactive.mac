# Interactive viewer (xamsopt -c config.json, no macro): Qt window with the geometry
/vis/open TSG
/vis/drawVolume
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility Liquid 0 true
/vis/geometry/set/visibility Gas 0 true
/vis/geometry/set/colour Liquid 0 0.15 0.35 0.85 0.18
/vis/geometry/set/colour Gas 0 0.55 0.75 1.0 0.08
/vis/geometry/set/visibility top_screenLayer 0 false
/vis/geometry/set/visibility anodeLayer 0 false
/vis/geometry/set/visibility gateLayer 0 false
/vis/geometry/set/visibility cathodeLayer 0 false
/vis/geometry/set/visibility bottom_screenLayer 0 false
/vis/geometry/set/colour PTFE 0 0.95 0.95 0.95 0.35
/vis/geometry/set/colour MeshRing 0 0.45 0.45 0.55 1
/vis/geometry/set/colour MeshBar 0 0.25 0.25 0.3 1
/vis/geometry/set/colour TopPMTWindow 0 0.6 0.8 1.0 0.3
/vis/geometry/set/colour BottomPMTWindow 0 0.6 0.8 1.0 0.3
/vis/geometry/set/colour TopPMTSector 0 0.95 0.6 0.1 1
/vis/geometry/set/colour BottomPMTCathode 0 0.95 0.6 0.1 1
/vis/geometry/set/colour TopPMTBody 0 0.15 0.15 0.15 0.4
/vis/geometry/set/colour BottomPMTBody 0 0.15 0.15 0.15 0.4
/vis/geometry/set/colour SiPM 0 0.1 0.8 0.2 1
/vis/viewer/set/style surface
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 70 20 deg
/vis/scene/add/axes 0 0 0 20 mm
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate 200
